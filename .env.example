# BetaOps Environment Variables

# Database
DATABASE_URL="postgresql://user:password@localhost:5432/betaops?schema=public"
SHADOW_DATABASE_URL="postgresql://user:password@localhost:5432/betaops_shadow?schema=public"

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here-generate-with-openssl-rand-base64-32"
NEXTAUTH_URL="http://localhost:3000"

# GitHub OAuth (for user login)
GITHUB_CLIENT_ID="your-github-oauth-client-id"
GITHUB_CLIENT_SECRET="your-github-oauth-client-secret"

# GitHub App (for repository integration)
GITHUB_APP_ID="your-github-app-id"
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour-private-key-here\n-----END RSA PRIVATE KEY-----"
GITHUB_WEBHOOK_SECRET="your-webhook-secret"
GITHUB_APP_TOKEN="your-installation-access-token"

# AI Provider (Google Gemini is the default)
AI_PROVIDER="gemini"  # gemini (default), openai, anthropic, or local
AI_API_KEY="your-google-gemini-api-key"
AI_DEFAULT_MODEL="gemini-1.5-pro"
AI_BASE_URL=""  # Optional: for custom endpoints

# Alternative AI Providers
# For OpenAI
# AI_PROVIDER="openai"
# AI_API_KEY="your-openai-api-key"
# AI_DEFAULT_MODEL="gpt-4-turbo-preview"

# For Anthropic
# AI_PROVIDER="anthropic"
# AI_API_KEY="your-anthropic-key"
# AI_DEFAULT_MODEL="claude-3-sonnet-20240229"

# For Local (Ollama)
# AI_PROVIDER="local"
# AI_BASE_URL="http://localhost:11434"
# AI_DEFAULT_MODEL="llama2"

# Email (for notifications and magic links)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASS="your-app-password"
SMTP_FROM="noreply@betaops.dev"

# File Storage (for evidence attachments)
# AWS S3
AWS_S3_BUCKET="betaops-attachments"
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"

# OR Cloudflare R2
# R2_ACCOUNT_ID="your-r2-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key"
# R2_SECRET_ACCESS_KEY="your-r2-secret-key"
# R2_BUCKET="betaops-attachments"

# Observability
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"

# OpenTelemetry (optional)
OTEL_EXPORTER_OTLP_ENDPOINT="https://api.honeycomb.io"
OTEL_EXPORTER_OTLP_HEADERS="x-honeycomb-team=your-api-key"

# Slack/Teams Webhooks (for notifications)
SLACK_WEBHOOK_URL="https://hooks.slack.com/services/YOUR/WEBHOOK/URL"
TEAMS_WEBHOOK_URL="https://outlook.office.com/webhook/YOUR/WEBHOOK/URL"

# Node Environment
NODE_ENV="development"  # development, production
